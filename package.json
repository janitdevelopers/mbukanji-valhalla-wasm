{
  "name": "@jansoft/mbujkanji-valhalla-wasm",
  "version": "0.1.0",
  "description": "Valhalla routing engine compiled to WebAssembly for offline-first web applications",
  "keywords": [
    "valhalla",
    "routing",
    "wasm",
    "webassembly",
    "offline",
    "maps",
    "navigation",
    "turn-by-turn",
    "directions",
    "osm",
    "openstreetmap"
  ],
  "homepage": "https://github.com/jansoft/mbujkanji-valhalla-wasm#readme",
  "bugs": {
    "url": "https://github.com/jansoft/mbujkanji-valhalla-wasm/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jansoft/mbujkanji-valhalla-wasm.git"
  },
  "license": "MIT",
  "author": "JanSoft",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cache": {
      "import": {
        "types": "./dist/cache.d.ts",
        "default": "./dist/cache.js"
      },
      "require": {
        "types": "./dist/cache.d.cts",
        "default": "./dist/cache.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "wasm",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:wasm": "cd native && ./build-wasm.sh",
    "dev": "next dev",
    "dev:lib": "tsup --watch",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@edge-runtime/vm": "latest",
    "@jansoft/mbujkanji-valhalla-wasm": "latest",
    "@microsoft/api-extractor": "latest",
    "@opentelemetry/api": "latest",
    "@radix-ui/react-accordion": "1.2.12",
