# npm configuration for @jansoft/mbujkanji-valhalla-wasm
# This file configures npm publishing settings

# Access level for scoped packages
# Options: public, restricted
# For public scoped packages, use 'public'
access=public

# Registry (uncomment and modify if using a custom registry)
# registry=https://registry.npmjs.org/

# Optional: Enable strict SSL (recommended)
# strict-ssl=true

# Optional: Save exact versions (not recommended for most packages)
# save-exact=false

# Optional: Package lock file settings
# package-lock=true
